{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CloserPacket",
  "type": "object",
  "required": [
    "packetId",
    "createdAt",
    "propertySnapshot",
    "sellerSnapshot",
    "buyerSnapshot",
    "knownNumbers",
    "missingNumbers",
    "opportunitySummary",
    "riskFlags",
    "recommendedNextMove"
  ],
  "properties": {
    "packetId": { "type": "string" },
    "createdAt": { "type": "string" },
    "propertySnapshot": { "type": "string" },
    "sellerSnapshot": { "type": "string" },
    "buyerSnapshot": { "type": "string" },
    "knownNumbers": { "type": "object", "additionalProperties": true },
    "missingNumbers": { "type": "array", "items": { "type": "string" } },
    "opportunitySummary": { "type": "string" },
    "riskFlags": { "type": "array", "items": { "type": "string" } },
    "recommendedNextMove": { "type": "string" }
  }
}
